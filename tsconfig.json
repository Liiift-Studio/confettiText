{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"jsx": "react-jsx",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"skipLibCheck": true,
		"lib": ["ES2020", "ES2022.Intl", "DOM", "DOM.Iterable"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "site", "demo"]
}
